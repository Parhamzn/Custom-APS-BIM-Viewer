# APS (Autodesk Platform Services) app credentials — copy this to ".env" and fill in.
# Get them from your app at https://aps.autodesk.com/myapps
APS_CLIENT_ID=your-client-id-here
APS_CLIENT_SECRET=your-client-secret-here

# --- Optional overrides (sensible defaults are used if left unset) ---
# APS_REGION=US                              # US (default) or EMEA — match your APS account region
# APS_BUCKET=                                # default: <clientid>-bimviewer (auto-derived)
# APS_OBJECT_KEY=LOD300_FINAL.rvt
# APS_MODEL_PATH=../LOD 300 FINAL MODEL Group 2.rvt
